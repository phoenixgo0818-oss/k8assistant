# Copy to .env.local and fill in (Supabase → Project Settings → API keys)
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key: server-only data access (bypasses RLS). Never expose.
SUPABASE_SECRET_KEY=sb_secret_...
# Publishable key: used server-side for sign-in / sessions (safe to expose, but we don't need to)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Who may sign in: comma-separated emails. Empty = nobody (fails closed).
ALLOWED_EMAILS=you@example.com
